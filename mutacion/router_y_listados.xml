  <rules>
    <!-- Además de las builtin: los literales booleanos (soloActivos,
         isLoading, los `return true/false` de create/update). -->
    <literal text="true" id="propia.true">
      <mutation text="false"/>
    </literal>
    <literal text="false" id="propia.false">
      <mutation text="true"/>
    </literal>
    <!-- `if (x) return ...;` sin llaves: builtin.if solo entiende `if (x) {`
         (con este caso se estira hasta la próxima llave y no compila). Acá
         se niega la condición de los guardas (`if (state.isLoading) return;`,
         `if (!ok) return false;`, el redirect por sesión). -->
    <regex pattern="(?&lt;=\s)if \(([^\n]*?)\) return" id="propia.if_sin_llaves">
      <mutation text="if (!($1)) return"/>
    </regex>
    <!-- Llamadas sin argumentos como sentencia: builtin.removeVoidCall exige
         al menos un carácter entre los paréntesis, así que nunca borra
         `load();` (el arranque de los cubits) ni los `dispose()`/`cancel()`
         que liberan la sesión y el router. -->
    <regex pattern="(?&lt;=[{;]\s*)[\w.]+\(\)\s*;" id="propia.quitar_llamada_sin_args">
      <mutation text=""/>
    </regex>
  </rules>

  <exclude>
    <!-- comentarios -->
    <token begin="//" end="\n"/>
    <regex pattern="/[*].*?[*]/" dotAll="true"/>
    <!-- imports y exports -->
    <token begin="import &apos;" end="&apos;;"/>
    <token begin="export &apos;" end="&apos;;"/>
    <!-- ++ y -: casi siempre falsos positivos -->
    <regex pattern="\+\+"/>
    <regex pattern="--"/>
    <!-- logs: mutar el texto o borrar el debugPrint no cambia nada que se
         vea (el `\s` final cubre el borrado de la sentencia entera, que
         termina justo después del `;`; venta_bloc.dart) -->
    <regex pattern="debugPrint\(.*?\);\s" dotAll="true"/>

    <!-- Mutantes que nunca compilan (no dicen nada de los tests):

         builtin.function.removeVoidCall arranca en el `;` de un campo
         (`final Tela tela;`) o en la `{` de la clase y borra el constructor
         que sigue (TelasState(...), TelasCreateRequested(this.tela),
         TelasBloc({...}) : super(...), MenuIndexCubit() : super(...)). -->
    <regex pattern="^\s*(?:late )?final [^=;]*;"/>
    <regex pattern="class [^{]*\{"/>
    <!-- builtin.if con `if (x) return;` sin llaves: se estira hasta la
         próxima `{` (ver propia.if_sin_llaves, que lo reemplaza). Se excluye
         solo el espacio donde arranca ese match, para no perder el resto de
         la línea. -->
    <regex pattern="\s(?=if \([^\n]*\) return)"/>
    <!-- builtin.function.arg2 en llamadas con argumentos de distinto tipo
         (Map/int, int/DateTime): intercambiarlos no compila. Se excluye solo
         el espacio donde arranca el match. -->
    <regex pattern="\s(?=\w+Repository\.(?:updateTela|updateAplique|updateSucursal|updateColor|createVenta|actualizarVenta|createDetalleVenta)\()"/>

    <!-- Mutantes EQUIVALENTES (sobrevivieron y no cambian nada observable):

         1. `isLoading: false` en un emit seguido de `return;` dentro del try
            (TelaBloc y SucursalBloc con id 0, DetalleVentasBloc sin líneas):
            el `finally` emite `isLoading: false` en la misma pasada
            síncrona, así que ponerlo en true solo agrega un estado
            intermedio que ningún frame llega a dibujar. -->
    <regex pattern="(?&lt;=isLoading: )false(?=\)\);\s*return;)"/>
    <!-- 2. Borrar ese mismo emit cuando solo pone isLoading (DetalleVentasBloc,
            `if (list.isEmpty) { emit(...isLoading: false); return; }`): el
            finally deja el mismo estado. Se excluye la `{` donde arranca
            builtin.removeVoidCall. -->
    <regex pattern="\{(?=\s*emit\(state\.copyWith\(isLoading: false\)\);\s*return;)"/>
    <!-- 3. El isLoading inicial de los cubits que cargan en el constructor
            (`load()` emite isLoading: true antes de su primer await, o sea
            dentro del mismo constructor: el valor inicial nunca se ve). -->
    <regex pattern="(?&lt;=(?:SucursalDisponibilidad|TelaColores|ApliqueColores|DetalleProduccion|DetalleVentaApliques)State\(\{\s*this\.isLoading = )false"/>
    <!-- 4. El isLoading inicial de TelasBloc: no tiene la guarda
            `if (state.isLoading) return;` de los otros listados (en esos
            el inicial en true sí rompe la carga y el mutante muere), y el
            constructor ya encola la carga, cuyo primer emit es
            isLoading: true. El valor inicial solo vive hasta ese evento. -->
    <regex pattern="(?&lt;=TelasState\(\{this\.isLoading = )false"/>
  </exclude>

  <threshold failure="80">
    <rating over="95" name="A"/>
    <rating over="80" name="B"/>
    <rating over="60" name="C"/>
    <rating over="40" name="D"/>
    <rating over="20" name="E"/>
    <rating over="0" name="F"/>
  </threshold>
</mutations>
